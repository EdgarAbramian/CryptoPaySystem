# ============================================================
#  .env.example — copy to .env and fill in your values
# ============================================================

# ── PostgreSQL ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:siski_123@127.0.0.1:5432/crypto_payments
REDIS_URL=redis://default:siski_123@80.89.238.37:6379/0
REDIS_QUEUE_TX_PROCESSING=tx_processing

# ── Redis ───────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
REDIS_QUEUE_TX_PROCESSING=tx_processing

# ── Bitcoin Node RPC ────────────────────────────────────────
# Testnet port=18332, mainnet port=8332
BITCOIN_RPC_URL=http://127.0.0.1:18332
BITCOIN_RPC_USER=rpcuser
BITCOIN_RPC_PASSWORD=rpcpassword

# ── Bitcoin Node ZMQ ────────────────────────────────────────
# Add to bitcoin.conf:
#   zmqpubrawtx=tcp://127.0.0.1:28333
#   zmqpubrawblock=tcp://127.0.0.1:28332
BITCOIN_ZMQ_RAW_TX=tcp://127.0.0.1:28333
BITCOIN_ZMQ_RAW_BLOCK=tcp://127.0.0.1:28332
ZMQ_RECONNECT_DELAY=5.0

# ── HD Wallet ───────────────────────────────────────────────
BTC_XPUB=tpubYOUR_XPUB_HERE
BTC_TESTNET=true

# ── Watcher ─────────────────────────────────────────────────
WATCHER_POLL_INTERVAL=30
REQUIRED_CONFIRMATIONS=1

# ── App ─────────────────────────────────────────────────────
DEBUG=false

# ── Ledger ───────────────────────────────────────────────────────────────────
REDIS_QUEUE_TX_RETRY=tx_retry
LEDGER_REQUIRED_CONFIRMATIONS=3
LEDGER_RETRY_DELAY=60
LEDGER_MAX_RETRIES=144
LEDGER_CONSUMER_TIMEOUT=2.0
LEDGER_CONCURRENCY=4

# ── Payout ───────────────────────────────────────────────────────────────────
# Account-level XPRIV — NEVER commit to git, NEVER log
# Generate: derive m/44'/1'/0' (testnet) from your seed, export xprv
BTC_XPRIV=tprv_YOUR_XPRIV_HERE
PAYOUT_CHANGE_INDEX=1000000
PAYOUT_FEE_RATE_SAT_VBYTE=10
PAYOUT_MIN_AMOUNT_SAT=10000
PAYOUT_DUST_THRESHOLD_SAT=546
